# Outlook 邮件管理 - 服务器版配置
# 复制为 .env 后填写

# 管理面板登录密码（必填）
ADMIN_PASSWORD=changeme

# 会话签名密钥，至少 32 位随机字符（必填）
# 可用命令生成: openssl rand -hex 32
COOKIE_SECRET=please_generate_a_long_random_secret_at_least_32_chars

# GPTMail API Key（可选，临时邮箱功能）
GPTMAIL_API_KEY=

# 监听端口（可选，默认 8787）
PORT=8787

# 定时任务间隔（可选，默认 6 小时）
CRON_INTERVAL_MS=21600000
